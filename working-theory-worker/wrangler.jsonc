{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kthq-mentors",
  "account_id": "a7443e0102de587d778491ab08fd883f",
  "main": "index.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "vars": {
    "SITE_ORIGIN": "https://kthq.org",
    "SUPABASE_URL": "https://fsdplcpmflywzoxydyno.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_uJ9FeZYBwSnyiFiH_R67yQ_zi9OudHw",
    "PUBLISHED_TOPICS": "[]",
    "SUBMISSIONS_ENABLED": "true"
  },
  "kv_namespaces": [
    { "binding": "mentors", "id": "b36a38624a4e4cf28ebd52cdc949b2bb" },
    { "binding": "takes", "id": "b49cc110c8594a42b0935b4dd3404620" }
  ],
  "ratelimits": [
    { "name": "SUBMISSION_LIMITER", "namespace_id": "617031", "simple": { "limit": 5, "period": 60 } }
  ]
  // Secrets: ADMIN_TOKEN, IDENTITY_SECRET, TURNSTILE_SECRET_KEY.
  // Set through Cloudflare, never here. The Supabase publishable key is public.
}
